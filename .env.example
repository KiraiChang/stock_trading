# backend 的應用設定範本（I-132）。
#
# 用法：
#   * 複製成 .env，放在 scripts 目錄（跟 compose.yml、deploy.sh 同一個目錄），chmod 600。
#     compose.yml 的 backend 用 env_file（絕對路徑）直接讀它；deploy.sh 部署前會檢查權限是 600。
#   * 一行一個 KEY=value，⛔ 不寫 export。⛔ 不要用 shell 的 source 讀這個檔：compose 的解析規則跟 shell 不一樣。
#   * ⛔ 不放 REDIS_PASSWORD：它只存在 Redis stack 的 .env，compose.yml 另外用 env_file 讀。
#   * 這裡的鍵⛔ 不能同時寫在 compose.yml 的 environment:（environment 的優先順序比較高，會蓋掉這裡的值）。
#   * 空值（KEY=）等於沒設定：backend 會退回 backend/config.yaml 的預設值。機密留空時，production
#     的設定契約會在連 DB 之前擋下（公開的範例值）。
#
# 寫法（compose 的 dotenv 規則；scripts/test-deploy-sh.sh 有實測）：
#   * 註解要自成一行、從第一個字元就是 #。⛔ 不要在值的後面接註解：沒有引號的值，` #` 之後會被當成註解丟掉，
#     有引號的值則會整段照收，兩種結果不同、容易誤會。
#   * 沒有引號或用雙引號的值裡，$X、${X} 會用**執行 docker compose 的那個 shell 的環境變數**展開
#     （沒設定的變數展開成空字串，⛔ 不報錯）。機密裡有 $ 而沒有用單引號，container 拿到的就是另一個值。
#   * 值裡有 $、#、引號，或前後有空白時，用**單引號**包起來：單引號內照字面讀，⛔ 不展開。
#     例：AUTH_JWT_SECRET='a$b#c'（`docker compose config` 的輸出會把 $ 寫成 $$，container 拿到的是一個 $）
#   * 沒有引號的值，前後的空白會被去掉；要保留就用單引號。
#   * 中間有空白（例如 cron）不需要引號；這裡為了一眼看出整段是一個值，cron 都用單引號。
#
# 預設值：機密留空；開關照 repo 的慣例全部是 false（⛔ 不把 live 已經打開的開關照搬成範本的預設）；
# 數值和 cron 是程式的預設值。

# ── 機密 ──────────────────────────────────────────────────────
# 至少 32 bytes（production 的設定契約）；用 `head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'` 產生 64 個 hex 字元。
AUTH_JWT_SECRET=
FINMIND_API_KEY=
# FUGLE_ENABLED=true 時才會用到
FUGLE_API_KEY=

# ── 行情來源 ──────────────────────────────────────────────────
# FinMind 盤中：帳號升級到 Sponsor 級以上再改為 true
FINMIND_INTRADAY_ENABLED=false
# Fugle：驗證通過、確定要開通即時行情後改為 true
FUGLE_ENABLED=false
# YAHOO_ENABLED 只控制**盤中報價**客戶端（非官方 API，免 token）；實盤驗證（T-032）通過後改為 true。
# 除權息逐檔同步（corporate_action_sync）無條件建立，不受它影響。
YAHOO_ENABLED=false
# 兩個 Yahoo 客戶端**共用同一個節流器**，速率就是這個值（每分鐘請求上限，批次計一次），所以它也節流除權息同步。
# 調到 finmind.rate_limit（5）以下會換成 Yahoo 主導逐檔節奏，CORPORATE_ACTION_TIMEOUT_SEC 的預算會失準。
# 詳見 backend/config.yaml 的 yahoo 註解。
YAHOO_RATE_LIMIT=20
# 單次請求帶入的 symbol 數，依實測調整
YAHOO_BATCH_SIZE=40

# ── 評估標的池（T-040 Step 5）────────────────────────────────
# 每交易日 16:00 維護池內標的的日 K。**預設關閉**：一次會對整個池（實測 131 檔）各發一個 FinMind 請求，
# 5 req/min 下約 27 分鐘。開啟前要先匯入選池成員（前端「評估標的池 → ③ 已入池」），空池時這個 job 什麼都不做。
# 16:00 晚於 daily_close（15:00，已確認當日日 K 已發布），且與 21:00 籌碼採集有近 5 小時緩衝。
# 這個池只維護日 K，不進盤中掃描、籌碼同步、signal 或 SR 分析。
EVALUATION_UNIVERSE_ENABLED=false
# 台北時區
EVALUATION_UNIVERSE_CRON='0 16 * * 1-5'
# 往前幾個日曆天；10 是為了容忍連假，成本與天數無關
EVALUATION_UNIVERSE_DAYS=10

# ── 日 K 缺漏偵測 ─────────────────────────────────────────────
# 現況見 docs/architecture.md「日 K 缺漏偵測」（原記於 issue.md I-091，已收斂）。沒有自己的 cron，跟著
# evaluation_universe 那輪（16:00）在回補之後跑，但寫獨立的 job_runs 紀錄 candle_gap_detection。
# 要解的是「evaluation_universe_sync 的 success 只代表請求沒失敗，不代表拿到該有的資料」。
# **預設關閉**；超出合法範圍的值會被正規化並記 Error log（見 backend/config.yaml 的說明）。
CANDLE_GAP_DETECTION_ENABLED=false
# 單一 (market, date) 缺漏比例 >= 此值就短路，合法 (0, 1]
CANDLE_GAP_DETECTION_AGGREGATE_RATIO=0.5
# 有效池不足此數時強制逐檔，不套比例
CANDLE_GAP_DETECTION_AGGREGATE_MIN_SYMBOLS=5
# **候選數不是請求數**；請求上限＝cap × 視窗月份數
CANDLE_GAP_DETECTION_CANDIDATE_CAP_PER_RUN=20
# 整輪上限，hard cap 900
CANDLE_GAP_DETECTION_TIMEOUT_SEC=300
# **交易日**不是日曆天；刻意不沿用 EVALUATION_UNIVERSE_DAYS
CANDLE_GAP_DETECTION_LOOKBACK_TRADING_DAYS=10
# 對交易所節流（2 req/s）；合法 >= 100
CANDLE_GAP_DETECTION_REQUEST_INTERVAL_MS=500
# 單位是預期交易日，不是日曆日
CANDLE_GAP_DETECTION_MARKET_STALE_DAYS=2
CANDLE_GAP_DETECTION_CALENDAR_TTL_HOURS=24
# **來源層級**，與逐 symbol 的失敗計數是兩回事
CANDLE_GAP_DETECTION_BREAKER_FAILURES=5
# 冷卻後自動恢復
CANDLE_GAP_DETECTION_BREAKER_COOLDOWN_MIN=60

# ── SR zone 分析排程 ──────────────────────────────────────────
# 定期對 watchlist 產生 SR zone 分析：每交易日兩輪，17:00 與 22:00。**預設關閉**：它是 production 驗證
# 母體的唯一來源（todo.md T-049 前置①的並行比對），開了就會每天累積分析。
# **前置已滿足**：事件老化早已改為依「K 棒推進」（2026-08-20 上線），排程與人工同日各跑一次不再讓老化
# 一天前進 2。現況規格見 docs/sr-zone-scoring.md「老化的單位是『K 棒推進』」（原記於 issue.md I-077，已收斂）。
# 兩個 cron 是刻意的：SR 分析吃籌碼（trading_score 的 Chip 佔 15%），而 FinMind 的法人／融資券要晚間才發布。
#   SR_ANALYSIS_CRON      17:00 → 當日 K 棒 ＋ 前一日籌碼（收盤後盡快有一份）
#   SR_ANALYSIS_CHIP_CRON 22:00 → 當日 K 棒 ＋ 當日籌碼（晚於 21:00 籌碼採集、早於 22:30 的 sr_evaluation）
# 兩輪都會跳過「最新 K 棒不是今天」的標的；chip 那輪額外跳過「當日籌碼尚未入庫」的。
# **不要設得比 80 小時稀疏**：/scheduler/status 的 stale 門檻寫死 80 小時。
SR_ANALYSIS_ENABLED=false
SR_ANALYSIS_CRON='0 17 * * 1-5'
SR_ANALYSIS_CHIP_CRON='0 22 * * 1-5'
SR_ANALYSIS_TIMEFRAME=1d
# 抓取的歷史 K 棒根數
SR_ANALYSIS_LIMIT=400

# ── 收盤 SR zone 驗證 ─────────────────────────────────────────
# 覆蓋窗口（單位是天，不是筆數）。詳見 backend/config.yaml 的 sr_zone_verify 註解。
SR_ZONE_VERIFY_DAYS=30
SR_ZONE_VERIFY_MAX_ANALYSES=2000

# ── 公司行動同步 ──────────────────────────────────────────────
# 分割／除權息／減資 → 還原係數。**沒有 enabled 開關**：漏跑一次會讓該檔整段歷史出現假跳空，重算又是冪等的，
# 所以沒有關掉它的情境；只有時間可調。06:30 早於 08:50 的 pre_market，讓開盤前的分析已吃到最新係數。
# 需要多跑幾次時直接設多時段（例如 '30 6,12 * * 1-5'）。打錯字時 backend 的設定契約會在啟動時擋下。
# **不要設得比 80 小時稀疏**：/scheduler/status 的 stale 門檻寫死 80 小時，稀疏排程會永遠顯示逾期
# （見 docs/api-reference.md）。
CORPORATE_ACTION_CRON='30 6 * * 1-5'
# 整輪預算與分片數。當日名單 = watchlist 全量 ＋ 其餘標的的當日分片，預設 5 片（週一到週五各一片，
# 每檔每週至少覆蓋一次）；設 1 = 每天全量。預算算法與調參時機見 backend/config.yaml 的 corporate_action 註解。
CORPORATE_ACTION_TIMEOUT_SEC=2700
CORPORATE_ACTION_SHARD_COUNT=5

# ── TWSE 終止上市名單對帳 ─────────────────────────────────────
# 規格見 docs/architecture.md「終止上市對帳」。每天 07:00 抓官方「終止上市公司」CSV，補 stock_symbols.delisted_date
# 並與主檔對帳。**預設關閉**（dev 驗收通過後改為 true）。
# ⚠️ **不驅動 is_listed**——那份 CSV 含歷史紀錄且代號會被重用（2002 年的光寶電子(2301) 與今天的光寶科(2301)
# 是兩家公司），判定「還在不在交易」的權責只屬於 stock_symbol_sync 的 ISIN 缺席邏輯。
# 前置是**依賴不是時間**：當日的 stock_symbol_sync（06:30）必須已成功，否則整輪 failed。
# ℹ️ 手動端點（POST /api/v1/scheduler/delisting-reconcile/run）**不看這個開關**——開關只決定要不要註冊 cron。
DELISTING_ENABLED=false
DELISTING_URL=https://www.twse.com.tw/rwd/zh/company/suspendListing?response=csv
# 台北時區，每天（不限平日）；⚠️ stale 門檻寫死 26 小時，不要設得比它稀疏
DELISTING_CRON='0 7 * * *'
# 0 = 沿用程式預設 60 秒（單一 CSV 請求，實測 8KB）
DELISTING_TIMEOUT_SEC=0

# ── 暫時性失敗的自動重跑（I-123～I-126）───────────────────────
# 規格見 docs/architecture/data-pipeline.md「失敗後的自動重跑」。主檔同步、公司行動同步（整輪早退）、
# 終止上市對帳遇到 DNS 逾時／連線錯誤／5xx／DB 連線類錯誤時，隔 10 分鐘重跑、每天最多 3 次、整輪在 08:45
# 之前結束；主檔成功後連帶重跑被它擋下的對帳。intraday 的批次與公司行動的失敗標的也在同一輪內再試。
# 4xx／429／解析錯誤⛔ 不重跑。**預設關閉**（dev 驗收通過後改為 true）。
# 回滾：改回 false 重新部署，確認 backend 啟動 log 的 `job retry config` 顯示 enabled=false。
JOB_RETRY_ENABLED=false
JOB_RETRY_INTERVAL_MIN=10
JOB_RETRY_MAX_RERUNS=3
# 台北 HH:MM，重跑整輪（含紀錄寫入）的截止；⛔ 不壓到 08:50 的盤前
JOB_RETRY_CUTOFF=08:45
